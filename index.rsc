a:[["$","source",null,{"media":"(max-width: 760px)","srcSet":"/brand/logo-kotel-compact.svg"}],["$","img",null,{"className":"brand__logo","src":"/brand/logo-kotel.svg","alt":"Липецкий котёл — информационно-аналитический канал","width":"1821","height":"281"}]]
1:["$","div",null,{"className":"site","id":"top","children":[["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"shell site-header__main","children":[["$","a",null,{"className":"brand","href":"#top","aria-label":"Липецкий котёл — на главную","children":["$","picture",null,{"children":"$a"}]}],["$","$Lb",null,{"items":[{"id":"16102","title":"От саженцев до посадок","category":"Суд и право","date":"27 нояб. · 18:58","text":"от саженцев до посадок в липецкой области представитель коммерческой организации подозревается в получении коммерческого подкупа в особо крупном размере в ходе оперативных мероприятий была установлена и раскрыта коррупционная схема группы лиц, занимавшихся выращиванием и… суд и право экономика чаплыгин регион суд и право"},{"id":"16101","title":"Мошенница из Липецкой области выманила 2 млн рублей у вдовы погибшего бойца СВО","category":"Экономика","date":"27 нояб. · 18:27","text":"мошенница из липецкой области выманила 2 млн рублей у вдовы погибшего бойца сво 42-летняя жительница добровского округа организовала в соцсети фиктивный сбор денег на лечение несуществующего раненого военнослужащего. на призыв о помощи откликнулась 49-летняя вдова участника сво, недавно потерявшая мужа. в результате женщина перевела… экономика суд и право происшествия регион экономика"},{"id":"16098","title":"Липецкая область: лидер по автомобилизации, в тройке лидеров по росту вакансий в автосервисах. Липецк — город автохлама?","category":"Транспорт","date":"27 нояб. · 17:51","text":"липецкая область: лидер по автомобилизации, в тройке лидеров по росту вакансий в автосервисах. липецк — город автохлама? 1️⃣ 🚗липецкая область входит в число самых автомобилизированных регионов страны. при этом средний чек автокредита здесь на 15% ниже российского, а спрос на работников автосервисов вырос почти в 2,5 раза. три показателя складываются в любопытную картину:… транспорт экономика россия и мир аналитика липецк регион транспорт"},{"id":"16096","title":"Депутаты из параллельного мира. Далеко от региона, далеко от народа","category":"Политика","date":"27 нояб. · 16:42","text":"депутаты из параллельного мира. далеко от региона, далеко от народа 1️⃣ депутат госдумы татьяна дьяконова новостям брянска рассуждает о кадровом дефиците, образовании и развитии гражданского общества в липецкой области. в её представлении регион почему-то оказался аграрным, работодатели страдают от необходимости обучать… политика образование экономика аналитика регион политика"},{"id":"16088","title":"Выборы закончились. Начались итоги работы правительства региона, которые жители ощущают не по красивым отчётам, а по ценникам, платёжкам и…","category":"Власть","date":"27 нояб. · 15:19","text":"выборы закончились. начались итоги работы правительства региона, которые жители ощущают не по красивым отчётам, а по ценникам, платёжкам и… проезд в липецке дорожает в 4,8 раза быстрее инфляции. пенсионеры теряют транспортную покупательную способность. 1️⃣ за полтора года проезд в липецке подорожает на 28–39%. это в несколько раз превышает накопленную инфляцию и индексацию страховых пенсий.… власть транспорт политика аналитика липецк регион власть"},{"id":"16087","title":"Облсуд отказал экс-главе липецкого УИЗО Ольге Крючковой в рассрочке штрафа в 50 млн рублей","category":"Экономика","date":"27 нояб. · 00:17","text":"облсуд отказал экс-главе липецкого уизо ольге крючковой в рассрочке штрафа в 50 млн рублей липецкий областной суд оставил в силе отказ предоставить бывшему главе управления имущественных и земельных отношений ольге крючковой рассрочку по штрафу в 50 млн рублей. жалобы осужденной суд рассмотрел в начале ноября, пишет абирег. штраф крючкова… экономика суд и право происшествия аналитика липецк усмань регион экономика"},{"id":"16086","title":"26 ноября указом президента РФ председателем Липецкого областного суда с 6-летним сроком полномочий назначен Игорь Мальчиков.","category":"Суд и право","date":"26 нояб. · 23:51","text":"26 ноября указом президента рф председателем липецкого областного суда с 6-летним сроком полномочий назначен игорь мальчиков. карьерный путь: ▪️&lrm;2004 год: начал судейскую карьеру в должности судьи центрального районного суда города тулы . ▪️&lrm;2009–2019 годы: работал судьёй тульского областного суда . в этот период он также возглавлял квалификационную коллегию судей… суд и право россия и мир власть регион суд и право"},{"id":"16085","title":"За хищение миллиардов у вкладчиков «Капитал Инвеста» осудили двух руководителей","category":"Суд и право","date":"26 нояб. · 18:47","text":"за хищение миллиардов у вкладчиков «капитал инвеста» осудили двух руководителей октябрьский районный суд липецка вынес заочный приговор бывшему председателю правления кредитного потребительского кооператива «капитал инвест» роману казакову и главному бухгалтеру юлии шкляевой. их признали виновными в мошенничестве с деньгами пайщиков.… суд и право экономика липецк елец регион суд и право"},{"id":"16084","title":"Секрет Полишинеля","category":"Власть","date":"26 нояб. · 18:38","text":"секрет полишинеля по информации наших источников, обладатель сингапурского диплома заместитель губернатора рябченко в ближайшее время может покинуть регион. его место скорее всего займёт глава лебедянского округа алексей телков, который ранее сменил романа ченцова в районе.… власть политика лебедянь регион власть"},{"id":"16082","title":"Продолжаем читать между строк","category":"ЖКХ","date":"26 нояб. · 17:57","text":"продолжаем читать между строк социальную поддержку решили поставить на бюджетный норматив. шариков: взять и поделить! правительство липецкой области больше не хочет разбираться, сколько конкретный ветеран или инвалид действительно тратит на коммунальные услуги. вместо компенсации… жкх экономика власть регион жкх"},{"id":"16081","title":"Читаем между строк инициативы, принятые облсоветом Липецкой области","category":"Политика","date":"26 нояб. · 16:22","text":"читаем между строк инициативы, принятые облсоветом липецкой области рождаемость в липецкой области растёт. получается, что власти готовят фильтр для приезжих родителей на очередной сессии липецкого областного совета депутатов 26 ноября рассмотрен и принят целый пакет законодательных инициатив правительства липецкой… политика суд и право регион политика"},{"id":"16080","title":"Федеральный проект «Чистый воздух» в Липецке в цифрах и фактах.","category":"Экология","date":"26 нояб. · 15:12","text":"федеральный проект «чистый воздух» в липецке в цифрах и фактах. наглядно на примере инфографики по липецку видно, что при формальном упоминании региональной символики (герб области внизу макета) содержательно программа представлена исключительно через достижения промышленного гиганта (нлмк) — это вклад градообразующего… экология россия и мир липецк регион экология"},{"id":"16079","title":"Цифра дня: 41 случай гриппа зарегистрирован в Липецкой области с начала эпидемического сезона.","category":"Здоровье","date":"26 нояб. · 14:38","text":"цифра дня: 41 случай гриппа зарегистрирован в липецкой области с начала эпидемического сезона. почти половина заболевших — дети: 23 случая. во всех подтвержден штамм гриппа а(h1n1), известный как свиной грипп. это высокопатогенный вирус, который нередко протекает тяжелее обычного сезонного гриппа и способен вызывать осложнения, в том числе поражение… здоровье регион здоровье"},{"id":"16077","title":"Китайская угроза о липецко-российско-китайском круговороте топинамбура.","category":"Россия и мир","date":"26 нояб. · 08:12","text":"китайская угроза о липецко-российско-китайском круговороте топинамбура. 2025 г. россия начала экспортировать топинамбур в китай (экспортер липецкая компания «истагро дон») 2026 г. китайский инулин из топинамбура начнут поставлять в россию (импортер липецкая компания «истагро дон»). 🇨🇳 китайская угроза круг замкнулся. сырьё… россия и мир экономика регион россия и мир"},{"id":"16074","title":"КРТ по-липецки и Строймастер: очередной скандал","category":"Суд и право","date":"25 нояб. · 21:16","text":"крт по-липецки и строймастер: очередной скандал @намприслаливидео 1️⃣ в центре липецка частный участок изымают под застройку семиэтажного дома. собственники утверждают, что вложенные в землю и проект 15 млн рублей при определении компенсации превратились в 5 млн, а согласованные для них ограничения по… суд и право происшествия экономика липецк регион суд и право"},{"id":"16065","title":"Чтобы это значило","category":"Политика","date":"25 нояб. · 19:46","text":"чтобы это значило бюджет липецка сжимается. жителям предлагают обсуждать его без подробностей 1️⃣ горсовет назначил на 8 декабря публичные слушания по бюджету на 2027–2029 годы. однако представленный мэрией документ на шести страницах даёт лишь общую картину расходов, без… политика образование власть аналитика липецк регион политика"},{"id":"16064","title":"РБК о том, что Wilka со стороны Липецкой области принёс непогоду Центральной России","category":"Россия и мир","date":"25 нояб. · 02:16","text":"рбк о том, что wilka со стороны липецкой области принёс непогоду центральной россии циклон над центральной россией сняли спутники «электро-л» и «арктика-м» 23 ноября, сообщили рбк в пресс-службе «роскосмоса». на изображении виден обширный облачный массив, москва отмечена в центральной части снимка. в правом верхнем углу представлена карта… россия и мир регион россия и мир"},{"id":"16063","title":"Профукали бюджет","category":"Экономика","date":"24 нояб. · 21:15","text":"профукали бюджет а тем временем по сообщению главы липецка михаила щербакова сегодня ночью в липецке ожидается снегопад и резкое похолодание. после оттепели это может привести к образованию гололёда. «поручил городским службам усилить работу в ночное время, чтобы к утру… экономика липецк регион экономика"},{"id":"16062","title":"Липецкая область заняла 53-е место в рейтинге российских регионов по суровости зимы","category":"Россия и мир","date":"24 нояб. · 21:15","text":"липецкая область заняла 53-е место в рейтинге российских регионов по суровости зимы липецкая область вошла в число российских регионов с климатом умеренной по российским меркам суровости с индексом 3,6 из 10, и в рейтинге регион занял 53-е место из 85. рейтинг за период с 2023 по 2025 год подготовила национальная ассоциация зимнего… россия и мир аналитика регион россия и мир"},{"id":"16061","title":"«Беломорканал» без разрешения: Усмань-табак оштрафовали за контрафактные папиросы","category":"Суд и право","date":"24 нояб. · 20:15","text":"«беломорканал» без разрешения: усмань-табак оштрафовали за контрафактные папиросы более 230 тысяч папирос под чужим товарным знаком произвело оао «усмань-табак». арбитражный суд липецкой области назначил предприятию штраф в 100 тысяч рублей, а изъятую продукцию постановил уничтожить. поводом для разбирательства стало обращение ао… суд и право экономика усмань регион суд и право"},{"id":"16060","title":"Складские помещения загорелись на площади 6 тысяч квадратных метров в Липецкой области, возгорание удалось локализовать, рассказали ЛК в…","category":"Происшествия","date":"24 нояб. · 18:30","text":"складские помещения загорелись на площади 6 тысяч квадратных метров в липецкой области, возгорание удалось локализовать, рассказали лк в… 6 тысяч квадратных метров составила площадь пожара на елецкой площадке оэз «липецк». пламя тушат 30 пожарных при помощи семи единиц техники, «по прибытии к месту вызова первых пожарно-спасательных подразделений было установлено, что происходило возгорание… происшествия липецк елец регион происшествия"},{"id":"16059","title":"Липецкая область — в тройке регионов РФ по доле импорта в оптовой торговле электроникой","category":"Экономика","date":"24 нояб. · 13:56","text":"липецкая область — в тройке регионов рф по доле импорта в оптовой торговле электроникой доля импортной продукции в обороте оптовой торговли россии в среднем за первые три квартала 2026 года составила 17,2% — за год показатель снизился в полтора раза: годом ранее зарубежные товары занимали почти четверть оптового товарооборота (24,8%). такие… экономика россия и мир аналитика регион экономика"},{"id":"16057","title":"Дела депутатские","category":"Политика","date":"23 нояб. · 19:55","text":"дела депутатские сергей курбатов, самый забавный депутат гд от липецкой области по мнению наблюдателей: сегодня на выездном заседании комитета госдумы по охране здоровья говорили о том, как готовить будущих медиков. вот что я для себя вынес. медицинский колледж и больница… политика здоровье образование регион политика"},{"id":"16056","title":"Что это значит: финал льготной ипотеки в Липецкой области","category":"Экономика","date":"23 нояб. · 18:46","text":"что это значит: финал льготной ипотеки в липецкой области льготная ипотека в липецкой области: выдачи упали на 82% — глубже, чем в среднем по россии жилищное кредитование · липецкая область · 23 ноября 2026 года по данным объединённого кредитного бюро (окб), в октябре 2026 года банки выдали жителям липецкой… экономика жкх россия и мир аналитика регион экономика"},{"id":"16055","title":"Глава Липецка Михаил Щербаков призвал горожан отказаться от поездок на личных автомобилях из-за сильного снегопада","category":"Власть","date":"23 нояб. · 18:45","text":"глава липецка михаил щербаков призвал горожан отказаться от поездок на личных автомобилях из-за сильного снегопада по прогнозу синоптиков, за ночь в липецке выпадет более 13 см снега. ожидаются усиление ветра и налипание мокрого снега. мэр призвал липчан по возможности отказаться от личных автомобилей и воспользоваться общественным транспортом, чтобы не мешать работе… власть транспорт липецк власть"},{"id":"16054","title":"Сильные осадки в виде мокрого снега, ветер до 17 м/с и обледенение в Липецкой области ожидается 23 ноября с 18:00. Завтра ещё не похолодает, а вот…","category":"Общество","date":"23 нояб. · 14:16","text":"сильные осадки в виде мокрого снега, ветер до 17 м/с и обледенение в липецкой области ожидается 23 ноября с 18:00. завтра ещё не похолодает, а вот…  общество регион общество"},{"id":"16053","title":"Россиянки хотят мужчин, которых нет в наличии, — гинеколог ВОЗ","category":"Россия и мир","date":"23 нояб. · 13:11","text":"россиянки хотят мужчин, которых нет в наличии, — гинеколог воз женщины ищут партнёров с образованием, деньгами и жильём, а таких мужчин «не хватает». поэтому в стране растёт число одиноких мужчин и одиноких женщин. а мужчины, которые «не котируются» на брачном рынке, уходят играть в видеоигры. а в тоже время игроки… россия и мир россия и мир"},{"id":"16052","title":"Работа в офисе уничтожает либидо и эрекцию у мужчин","category":"Общество","date":"23 нояб. · 13:10","text":"работа в офисе уничтожает либидо и эрекцию у мужчин по словам сексолога, сидячая работа вызывает застойные явления, которые «цементируют» выработку сперматозоидов. чтобы избежать этого, специалист советует чаще вставать, гулять и делать зарядку. общество общество"},{"id":"16051","title":"Когда липчанам рапортуют о порядке на контейнерных площадках и благоприятной санитарно-эпидемиологической","category":"Власть","date":"23 нояб. · 12:47","text":"когда липчанам рапортуют о порядке на контейнерных площадках и благоприятной санитарно-эпидемиологической обстановке, надзорные (контрольные) органы порой на жалобы отвечают отписками, чиновники получают ордена, а грызуны вскрывают этот когнитивный диссонанс. крысы управляют территорией неподалёку от здания правительства крысиное нашествие ожидает россию в… власть экология жкх липецк регион власть"},{"id":"16050","title":"Липецкая область опустилась на 22-м место по покупательной способности и феномен «бумажного» благополучия","category":"Экономика","date":"23 нояб. · 12:20","text":"липецкая область опустилась на 22-м место по покупательной способности и феномен «бумажного» благополучия опубликованный аналитиками риа новости \"рейтинг по доходам населения\" , поместивший липецкую область на 22-е место, наглядно демонстрирует феномен «бумажного» благополучия региона. цифры этого исследования отражают не реальное экономическое состояние… экономика россия и мир политика аналитика липецк елец регион экономика"},{"id":"16041","title":"«Старые долги» — это не про фильм, который был снят в Липецкой области","category":"Культура","date":"21 нояб. · 20:06","text":"«старые долги» — это не про фильм, который был снят в липецкой области обновленный анализ проекта бюджета 2027–2029 гг., представленный на публичных слушаниях в облсовете. бюджет 2027–2029 гг. — это остаток полномочий действующей команды (до 2029-го). на чём поставят крест, что липчане не увидят, как своих ушей (список можете… культура экономика суд и право аналитика липецк елец лебедянь культура"},{"id":"16040","title":"Напоминаем заранее. Не забудьте","category":"Общество","date":"21 нояб. · 19:08","text":"напоминаем заранее. не забудьте 💰 россияне солят деньги, чтобы разбогатеть вечером воскресенья нужно посыпать купюру щепоткой соли и оставить так до утра, а в понедельник провести этой купюрой по левой ладони и произнести: «вожу к деньгам». планы на вечер готовы общество общество"},{"id":"16039","title":"У каждого своя мера счастья: от 273 тысяч до бесконечности","category":"Экономика","date":"21 нояб. · 14:22","text":"у каждого своя мера счастья: от 273 тысяч до бесконечности пока отдельные собственники предприятий липецкой области наращивают миллиардные прибыли и готовятся выплачивать дивиденды, доходы значительной части жителей остаются куда скромнее. официальная статистика и социологические оценки показывают весьма разное… экономика аналитика елец регион экономика"},{"id":"16035","title":"Как говорится, кто не знает, что происходит в стенах горсовета, тот не был в цирке","category":"Политика","date":"20 нояб. · 14:51","text":"как говорится, кто не знает, что происходит в стенах горсовета, тот не был в цирке хроники коммунального зазеркалья: как в липецке зиму встречали и тупиковая тишина в финале (\"а вдоль дороги мёртвые с косами стоят...\" , — кино) 1️⃣ очередное заседание комиссии по жкх в липецком горсовете, видимо, превратилось в сеанс коллективной амнезии… политика суд и право жкх аналитика липецк регион политика"},{"id":"16034","title":"Ещё один ветеринар. Шпионское пособие по развалу изнутри всего того, что было создано. Просто разные фамилии","category":"Власть","date":"19 нояб. · 21:06","text":"ещё один ветеринар. шпионское пособие по развалу изнутри всего того, что было создано. просто разные фамилии министром сельского хозяйства липецкой области назначен никита кубрак, ранее занимавший должность замначальника управления ветеринарии региона. он приступит к новым обязанностям 20 ноября, сообщили в облправительстве. с ноября 2024 г. ведомство возглавляла… власть экономика липецк елец регион власть"},{"id":"16033","title":"Липецкая область выпала из автокредитного бума: октябрьский рекорд России обошел регион стороной, где выбирают дешёвые авто и растягивают срок…","category":"Экономика","date":"19 нояб. · 15:06","text":"липецкая область выпала из автокредитного бума: октябрьский рекорд россии обошел регион стороной, где выбирают дешёвые авто и растягивают срок… в октябре российские банки выдали рекордную сумму автокредитов с начала года — 190,4 млрд рублей. однако липецкая область показала спад глубже общероссийского: число сделок сократилось на 21% год к году, а объем выданных средств — на 17%. причина — в… экономика россия и мир аналитика липецк регион экономика"},{"id":"16032","title":"В 2023 году Липецкая область сдала почти весь государственный птицеводческий комплекс в Дубовом АО «Куриное Царство» до февраля 2048-го. В конце…","category":"Сельское хозяйство","date":"19 нояб. · 04:45","text":"в 2023 году липецкая область сдала почти весь государственный птицеводческий комплекс в дубовом ао «куриное царство» до февраля 2048-го. в конце… за 68,08 млн рублей продают 22,8 га земли и 49 объектов общей площадью почти 34 тыс. кв. метров. в списке — 18 птичников, административное здание, гараж, кормовые бункеры, подстанции и водопровод. ао «куриное царство» продолжит пользоваться почти всем… сельское хозяйство экономика регион сельское хозяйство"},{"id":"16029","title":"Минус шесть позиций за год: Липецкая область опустилась на 24-е место в национальном рейтинге кластерного развития","category":"Экономика","date":"18 нояб. · 19:20","text":"минус шесть позиций за год: липецкая область опустилась на 24-е место в национальном рейтинге кластерного развития 1️⃣ липецкая область потеряла шесть позиций в национальном рейтинге кластерного развития, заняв 24-е место из 72 регионов. при наличии оэз и промышленной инфраструктуры область получила ноль баллов за инвестиционную привлекательность, а все действующие… экономика россия и мир власть аналитика грязи регион экономика"},{"id":"16028","title":"Глава Липецка Михаил Щербаков: В Липецке после земляных работ остаются не приведёнными в порядок более ста участков. Несмотря на первый снег, там…","category":"Власть","date":"18 нояб. · 17:07","text":"глава липецка михаил щербаков: в липецке после земляных работ остаются не приведёнными в порядок более ста участков. несмотря на первый снег, там… михаил щербаков поручил ответственным подразделениям усилить претензионную работу и добиваться привлечения нарушителей к ответственности. он также заявил, что продолжит лично проверять исполнение поручений власть липецк власть"},{"id":"16026","title":"А вот и первый снег. Накануне депутаты и мэрия обсуждали его уборку","category":"Политика","date":"18 нояб. · 16:44","text":"а вот и первый снег. накануне депутаты и мэрия обсуждали его уборку липецк готов к зиме. поёт акын про искусство управления городским хозяйством в отсутствии необходимых средств. а снег идёт 1️⃣ в липецком горсовете состоялся очередной сеанс муниципального оптимизма. и. о. председателя департамента дорожного хозяйства и… политика власть жкх липецк регион политика"},{"id":"16024","title":"ФАС наказала Липецкую область: региональные власти создавали преимущества для компаний, уже имевших статус оператора на этой территории.","category":"Суд и право","date":"18 нояб. · 02:33","text":"фас наказала липецкую область: региональные власти создавали преимущества для компаний, уже имевших статус оператора на этой территории. федеральная антимонопольная служба выявила нарушения в семи регионах при назначении временных региональных операторов по обращению с твёрдыми коммунальными отходами (тко). в числе таких регионов оказалась липецкая область. регионы прописали в правилах, что… суд и право экология власть липецк регион суд и право"},{"id":"16022","title":"Дважды «против»: спектакль одного актёра с заранее известным финалом","category":"Суд и право","date":"17 нояб. · 23:06","text":"дважды «против»: спектакль одного актёра с заранее известным финалом 1️⃣ депутат госдумы от липецкой области сергей курбатов (экс-заместитель губернатора по экономическим вопросам) торжественно сообщил: впервые проголосовал против — и сразу дважды. один законопроект повышает штрафы за отдельные экономические преступления,… суд и право происшествия политика регион суд и право"},{"id":"16021","title":"Липецкий гипермаркет «О’КЕЙ» в ТРЦ \"Европа\" сменит бренд на «Ленту» 27 ноября: детали обновления","category":"Экономика","date":"17 нояб. · 12:52","text":"липецкий гипермаркет «о’кей» в трц \"европа\" сменит бренд на «ленту» 27 ноября: детали обновления липецкий гипермаркет «о’кей», расположенный по адресу ул. советская, 66, готовится к масштабному ребрендингу. напомним, что в июне текущего года этот объект был приобретен «группой лента», и теперь компания приступила к его полной интеграции в свою… экономика россия и мир экономика"},{"id":"16012","title":"Заброшенный пионерлагерь — фото липчанина","category":"Образование","date":"16 нояб. · 20:28","text":"заброшенный пионерлагерь — фото липчанина куда уходит детство в какие города? и где найти нам средства чтоб вновь попасть туда «прометей» полностью не реконструируют даже за следующие три года липецкая область не вошла в число восьми лидеров летней оздоровительной кампании 2026 года. при этом за… образование экономика россия и мир липецк регион образование"},{"id":"15998","title":"Сюрпризы и риски. Эксперты и авторы ЛК сделали анализ проекта областного бюджета на 2027 год и на плановый период 2028 и 2029 годов, сравнение (с…","category":"Экономика","date":"16 нояб. · 16:34","text":"сюрпризы и риски. эксперты и авторы лк сделали анализ проекта областного бюджета на 2027 год и на плановый период 2028 и 2029 годов, сравнение (с… бюджет-2027-2029: обвал базы, банковский манёвр и арифметический профицит проект областного бюджета липецкой области против факта 2024-2025 годов и планов 2026-2028 годов 1️⃣ 18 ноября в 14.00 в большом зале правительства региона пройдут публичные слушания… экономика суд и право жкх аналитика липецк елец данков экономика"},{"id":"15997","title":"Липецкая область в рейтинге ЗОЖ: 19-е место в стране на фоне противоречий","category":"Здоровье","date":"16 нояб. · 09:37","text":"липецкая область в рейтинге зож: 19-е место в стране на фоне противоречий спорт, спиртное и устойчивый рост общей и первичной заболеваемости ожирением, сахарным диабетом второго типа и болезнями системы кровообращения спокойно уживаются в одном регионе — просто в разных измерениях: липецкая область — 7-я в цфо по зож и входит в… здоровье спорт россия и мир аналитика регион здоровье"},{"id":"15995","title":"BFM о том, что Пушкина отредактировали","category":"Общество","date":"16 нояб. · 09:15","text":"bfm о том, что пушкина отредактировали из стихотворения «зимний вечер» убрали самую запоминающуюся строфу: выпьем, добрая подружка бедной юности моей, выпьем с горя; где же кружка? сердцу будет веселей. на шедевр посягнули в школьных учебниках по литературе за 3 класс из стихотворения «зимний… общество общество"},{"id":"15993","title":"Главное за неделю в Липецке: \"не спрашивай по ком звонят колокола\".","category":"Власть","date":"15 нояб. · 16:27","text":"главное за неделю в липецке: \"не спрашивай по ком звонят колокола\". 1️⃣ парковочный капкан. в липецке стартует второй этап расширения зоны платных парковок. если вы не интересуетесь градостроительством и игнорируете публичные слушания, градостроительная политика сама придет за вашим автомобилем и переставит его на платную… власть экономика здоровье аналитика липецк регион власть"},{"id":"15991","title":"Сын легендарного белорусского борца Алексея Шемарова заразил около 30 девушек в Калининграде и других городах России хламидиями, чтобы стать…","category":"Россия и мир","date":"14 нояб. · 15:08","text":"сын легендарного белорусского борца алексея шемарова заразил около 30 девушек в калининграде и других городах россии хламидиями, чтобы стать… знакомьтесь, александр шемаров. парню 20 лет, он играет в хоккей за мхк \"липецк\". со слов пострадавших, во время выездов он знакомится в дейтинге с девушками, а потом заражает их зппп. некоторые из жертв биотеррориста оказались блогершами из калининграда.… россия и мир липецк россия и мир"},{"id":"15989","title":"РЕН ТВ о том, что самый известный киллер России, отбывающий срок в липецкой ИК-2, обрёл новую жену","category":"Происшествия","date":"14 нояб. · 14:24","text":"рен тв о том, что самый известный киллер россии, отбывающий срок в липецкой ик-2, обрёл новую жену киллер леша солдат, который сидит в колонии строгого режима, снова женился. брак заключили в липецкой области, где осужденный отбывает наказание. новой избранницей одиозного киллера стала 48-летняя юлия. о супруге известно немногое. раньше работала в… происшествия россия и мир регион происшествия"},{"id":"15988","title":"Лисин зарегистрировал в Липецке девелоперскую компанию «Локус Девелопмент»","category":"Экономика","date":"13 нояб. · 02:59","text":"лисин зарегистрировал в липецке девелоперскую компанию «локус девелопмент» председатель совета директоров нлмк владимир лисин пополнил портфель новой компанией — ооо «локус девелопмент», зарегистрированной 15 октября 2026 года в липецке. об этом стало известно телеграм-каналу «липецкий котел». единственный владелец — московское… экономика аналитика липецк регион экономика"},{"id":"15986","title":"Сергей Михайлович, два кошелька — ещё не два бюджета","category":"Экономика","date":"12 нояб. · 20:27","text":"сергей михайлович, два кошелька — ещё не два бюджета 1️⃣ недавно лк рассказал, что в госдуме озвучили прогноз вымирания россии, а кто-то в это время лечил пиццей и сушами, и выяснял у ии, что тот чувствует. напомним. член комитета госдумы по охране здоровья, депутат-коммунист алексей куринный, сообщил, что в… экономика политика здоровье аналитика регион экономика"},{"id":"15984","title":"Что это значит","category":"Власть","date":"12 нояб. · 19:27","text":"что это значит армия безработных в липецке может пополниться двумя тысячами человек мэрия намерена сократить 2900 штатных единиц в муниципальных учреждениях. глава города объясняет решение дефицитом бюджета, раздутыми аппаратами управления и необходимостью повысить… власть экономика аналитика липецк регион власть"},{"id":"15972","title":"Бюджет Липецкой области: от рекордного дефицита к экономии. Кто заплатит за бюджетную консолидацию","category":"Экономика","date":"12 нояб. · 17:00","text":"бюджет липецкой области: от рекордного дефицита к экономии. кто заплатит за бюджетную консолидацию 1️⃣ два ноябрьских бюджетных решения с разницей в год показывают смену финансовой политики липецкой области. в 2025 г. расходы наращивали, а дефицит довели до 28,9 млрд ₽. в 2026-м расходы впервые за год сократили, дефицит уменьшили на 4 млрд. при этом… экономика суд и право здоровье аналитика регион экономика"},{"id":"15971","title":"Абирег о том, что дом площадью 352,1 кв. м оказался никому не нужен","category":"Экономика","date":"12 нояб. · 11:28","text":"абирег о том, что дом площадью 352,1 кв. м оказался никому не нужен дом невыездного липецкого бизнесмена викулина не нашел покупателя на торгах торги по продаже жилого дома и земельного участка липецкого бизнесмена евгения викулина признаны несостоявшимися — на аукцион не поступило ни одной заявки. об этом сообщил… экономика аналитика регион экономика"},{"id":"15970","title":"Арбитражный суд Липецкой области вынес решение о взыскании с белорусского металлургического завода более 22 млн рублей по иску елецкого предприятия","category":"Суд и право","date":"12 нояб. · 11:22","text":"арбитражный суд липецкой области вынес решение о взыскании с белорусского металлургического завода более 22 млн рублей по иску елецкого предприятия в арбитражный суд липецкой области обратилось акционерное общество «ольшанский карьер» с исковым заявлением к открытому акционерному обществу «белорусский металлургический завод – управляющая компания холдинга «белорусская металлургическая компания» (оао… суд и право экономика россия и мир елец регион суд и право"},{"id":"15969","title":"В Липецкой области собрали 72 тысячи тонн яблок!","category":"Сельское хозяйство","date":"12 нояб. · 07:21","text":"в липецкой области собрали 72 тысячи тонн яблок! садоводческие хозяйства региона получили более 73 тысяч тонн плодово-ягодной продукции в 2026 году. основную долю урожая составили яблоки. также аграрии собрали 130 тонн вишни и черешни, а урожай ягод превысил тысячу тонн. большая часть ягодной продукции… сельское хозяйство аналитика регион сельское хозяйство"},{"id":"15966","title":"Переходим теперь к нашим «сингапурскому»…","category":"Власть","date":"11 нояб. · 19:44","text":"переходим теперь к нашим «сингапурскому»… власть разделилась во мнениях. одни чиновники (сторонники царских градоначальников) создали себе кумира — самый дешевый способ создать себе вечность и почитание за бюджетные деньги, пока город деградирует в реальном времени, другие (ряженные викинги,… власть культура россия и мир липецк регион власть"},{"id":"15965","title":"Липецкая область не вошла в топ-10 регионов по качеству дорог. 84,6% ни ям, ни трещин?","category":"Транспорт","date":"11 нояб. · 16:04","text":"липецкая область не вошла в топ-10 регионов по качеству дорог. 84,6% ни ям, ни трещин? более того, липецкая область уступила восьми регионам центрального федерального округа. липецкая область не вошла в топ-10 российских регионов по качеству дорог, где оказались сразу три территории цфо — ивановская, брянская и курская области. их показатели… транспорт аналитика регион транспорт"},{"id":"15964","title":"НЛМК — в числе лучших работодателей России","category":"Экономика","date":"11 нояб. · 14:39","text":"нлмк — в числе лучших работодателей россии рбк представил пятый рейтинг российских работодателей 2026 года. в анкетировании приняли участие 361 компания с общим штатом 5,05 млн человек. победители распределены по группам: все участники одной группы занимают одинаковую позицию и упорядочены по… экономика россия и мир аналитика липецк регион экономика"},{"id":"15961","title":"Липецк в топ-8 рейтинга платных парковок: триумф цифровизации или иллюзия комфорта","category":"Транспорт","date":"11 нояб. · 13:15","text":"липецк в топ-8 рейтинга платных парковок: триумф цифровизации или иллюзия комфорта опубликован рейтинг городов россии по развитию платного парковочного пространства за 2026 г. исследование от «дорнадзора» традиционно вызывает много вопросов у урбанистов и жителей, но в этот раз липецкий кейс выглядит особенно показательно. разбираемся,… транспорт аналитика липецк регион транспорт"},{"id":"15960","title":"10 ноября — День памяти Леонида Ильича Брежнева — человека эпохи стабильности, промышленной мощи и социальной защищённости","category":"Экономика","date":"10 нояб. · 16:17","text":"10 ноября — день памяти леонида ильича брежнева — человека эпохи стабильности, промышленной мощи и социальной защищённости 10 ноября 1982 года скончался леонид ильич брежнев — руководитель ссср с 1964 по 1982 год, участник великой отечественной войны и парада победы 1945 года. его имя навсегда связано с периодом, который позже стал называть «застоем», но который, с точки… экономика жкх здоровье регион экономика"},{"id":"15959","title":"Рост зарплаты приводит к алкоголизму - исследование","category":"Экономика","date":"10 нояб. · 15:47","text":"рост зарплаты приводит к алкоголизму - исследование ▪️ премии и карьерный рост повышают риск спиться, потому что появляются деньги и различные поводы выпить. «рост дохода может быть не менее рискованным, хотя окружающим он кажется благополучным событием: у человека появляется возможность чаще покупать… экономика экономика"},{"id":"15958","title":"Один укол фельдшера обошёлся районной больнице в 312 тысяч рублей","category":"Здоровье","date":"10 нояб. · 15:19","text":"один укол фельдшера обошёлся районной больнице в 312 тысяч рублей обычная внутримышечная инъекция закончилась редким тяжёлым осложнением, многомесячным лечением и судебным разбирательством. елецкая районная больница не смогла доказать отсутствие вины медицинского персонала. в начале марта 2025 года фельдшер одной из… здоровье экономика суд и право елец регион здоровье"},{"id":"15957","title":"Красиво жить всё же запретишь","category":"Суд и право","date":"10 нояб. · 15:02","text":"красиво жить всё же запретишь долг свыше 900 миллионов и мальдивы. липецкий банкрот временно лишился права на выезд из россии арбитражный суд липецкой области временно ограничил выезд за границу гражданину, проходящему процедуру банкротства. поводом стало ходатайство финансового… суд и право экономика россия и мир регион суд и право"},{"id":"15956","title":"Bloomberg: передача активов JTI затронула Елецкую табачную фабрику и бюджет Японии","category":"Экономика","date":"10 нояб. · 14:48","text":"bloomberg: передача активов jti затронула елецкую табачную фабрику и бюджет японии российский бизнес японского табачного гиганта japan tobacco international (jti), включая предприятие в ельце, перешёл под временное управление ао «промышленные активы». bloomberg оценил возможные финансовые последствия решения для японского правительства,… экономика россия и мир аналитика елец регион экономика"},{"id":"15955","title":"В Липецкой области оперативники изъяли из найденной в частном доме нарколаборатории около 60 кг «соли»","category":"Происшествия","date":"10 нояб. · 12:39","text":"в липецкой области оперативники изъяли из найденной в частном доме нарколаборатории около 60 кг «соли» сотрудниками управления по контролю за оборотом наркотиков умвд россии по липецкой области при взаимодействии с коллегами из регионального уфсб россии пресечена противоправная деятельность трёх жителей воронежской области, организовавших лабораторию по… происшествия суд и право регион происшествия"},{"id":"15954","title":"ВЕДОМОСТИ о двойном голосовании","category":"Политика","date":"10 нояб. · 11:15","text":"ведомости о двойном голосовании 🕉☸️🪯✡️ цик может представить итоги проверки двойного голосования на выборах 2026 года на следующей неделе 🟩региональные избиркомы должны были проверить возможные нарушения до 5 ноября. сейчас цик анализирует полученные данные, сообщил источник, близкий… политика регион политика"},{"id":"15952","title":"В Госдуме озвучили прогноз вымирания России, а кто-то в это время лечил пиццей и сушами, и выяснял у ИИ, что тот чувствует","category":"Политика","date":"9 нояб. · 21:46","text":"в госдуме озвучили прогноз вымирания россии, а кто-то в это время лечил пиццей и сушами, и выяснял у ии, что тот чувствует пока один депутат-коммунист рисовал апокалипсис на 600 тысяч человек из-за урезания медицины, другой депутат от «новых людей» мирно поздравлял университет, обсуждал пиццу в школе и пытался понять чувства искусственного интеллекта. в госдуме внезапно… политика здоровье россия и мир аналитика регион политика"},{"id":"15951","title":"Сняли со стены портрет Игоря Домникова. Журналиста, убитого за расследования о коррупции в Липецкой области.","category":"Суд и право","date":"9 нояб. · 16:18","text":"сняли со стены портрет игоря домникова. журналиста, убитого за расследования о коррупции в липецкой области. в редакции «новой газеты»* сняли портреты журналистов, погибших за время существования издания. среди них — игорь домников, чья профессиональная деятельность была напрямую связана с липецкой областью. все эти годы черно-белые портреты журналистов, погибших… суд и право происшествия регион суд и право"},{"id":"15950","title":"«Доброе сало» отменили. «Русборг» фестивалит","category":"Культура","date":"9 нояб. · 15:28","text":"«доброе сало» отменили. «русборг» фестивалит в липецкой области массовые мероприятия отменяют по соображениям безопасности. однако этот принцип, судя по всему, применяется не ко всем одинаково. xv гастрономический фестиваль «доброе сало» в добровском округе, отменён. об этом сообщили в правительстве… культура экономика власть регион культура"},{"id":"15949","title":"С Олега Донских взыскали почти 1,7 млрд рублей в пользу «Росагролизинга»","category":"Суд и право","date":"9 нояб. · 13:04","text":"с олега донских взыскали почти 1,7 млрд рублей в пользу «росагролизинга» советский районный суд липецка постановил взыскать с бывшего чиновника минсельхоза россии и экс-начальника управления сельского хозяйства администрации липецкой области олега донских 1 млрд 687 млн 777 тыс. рублей в качестве возмещения материального ущерба… суд и право экономика сельское хозяйство липецк регион суд и право"},{"id":"15948","title":"«Совести нет у тех, кто это делает»: Вячеслав Володин осудил необоснованный рост тарифов на услуги ЖКХ в регионах страны.","category":"Экономика","date":"9 нояб. · 07:39","text":"«совести нет у тех, кто это делает»: вячеслав володин осудил необоснованный рост тарифов на услуги жкх в регионах страны. вячеслав володи предложил отказаться от концессий. на фоне того, что почти треть работников липецкой области получают меньше 45 тысяч рублей (субъективная бедность) , правительство липецкой области подготовил проект постановления о предельных индексах… экономика жкх политика аналитика липецк регион экономика"},{"id":"15947","title":"Липецкая область заняла 53-е место в рейтинге регионов РФ по уровню и распределению зарплат","category":"Экономика","date":"9 нояб. · 07:32","text":"липецкая область заняла 53-е место в рейтинге регионов рф по уровню и распределению зарплат по исследованию риа «новости» (центр экономических исследований «риа рейтинг»), регион опустился на две позиции по сравнению с рейтингом 2025 года (тогда было 51-е место). данные охватывают период с сентября 2025 по август 2026 года и основаны на… экономика россия и мир аналитика регион экономика"},{"id":"15946","title":"Елецкий табачный актив под временным управлением: кому достанется прибыльный бизнес","category":"Экономика","date":"7 нояб. · 18:37","text":"елецкий табачный актив под временным управлением: кому достанется прибыльный бизнес президент россии владимир путин подписал указ о передаче под временное управление ао «промышленные активы» российских структур японской табачной корпорации japan tobacco international (jti). в перечень вошло и елецкое предприятие «дж.т.и. елец». решение… экономика россия и мир елец регион экономика"},{"id":"15944","title":"Особое мнение","category":"Суд и право","date":"7 нояб. · 17:46","text":"особое мнение халатность как система. сети те же, пострадавшей снова 19 лет комментарий «липецкого котла» к сообщению ск о возбуждении уголовного дела после аварии на улице литаврина 5 ноября 2026 г. на улице литаврина в липецке 19-летняя девушка получила термические… суд и право происшествия жкх аналитика липецк регион суд и право"},{"id":"15943","title":"В Липецке возбуждено уголовное дело по факту травмирования местной жительницы в результате порыва трубопровода","category":"Суд и право","date":"7 нояб. · 17:41","text":"в липецке возбуждено уголовное дело по факту травмирования местной жительницы в результате порыва трубопровода со по советскому округу г. липецка су ск россии по липецкой области возбуждено уголовное дело в отношении должностных лиц ресурсоснабжающей организации по признакам преступления, предусмотренного ч. 1 ст. 293 ук рф (халатность). по данным следствия, 5… суд и право происшествия липецк регион суд и право"},{"id":"15940","title":"7 ноября — дата, отмечавшаяся в СССР как годовщина Октябрьской революции 1917 г. В советское время этот день был одним из ключевых государственных…","category":"Экономика","date":"7 нояб. · 14:43","text":"7 ноября — дата, отмечавшаяся в ссср как годовщина октябрьской революции 1917 г. в советское время этот день был одним из ключевых государственных… в 1995 г. указом б. ельцина праздник «день великой октябрьской социалистической революции» был официально исключён из числа государственных праздников. причиной стало стремление к переосмыслению исторической памяти в условиях перехода к капитализму и… экономика россия и мир жкх аналитика регион экономика"},{"id":"15938","title":"«Липецкий котел» приготовил аналитическую записку (подробно в прикрепленном файле) по решению депутатов и правительства Липецкой области поднять…","category":"Политика","date":"6 нояб. · 19:07","text":"«липецкий котел» приготовил аналитическую записку (подробно в прикрепленном файле) по решению депутатов и правительства липецкой области поднять… «бесхозяйные трубы» и тариф на 45,9%: инфраструктурные проблемы не заменяют экономический расчёт на сессии облсовета повышение тарифа на водоотведение для «рвк-липецк» обосновывали приростом сетей, их износом и необходимостью увеличения операционных… политика власть экономика аналитика липецк регион политика"},{"id":"15937","title":"Платная парковка вместо парковочной политики: Липецку обещают 3,5 тысячи мест","category":"Транспорт","date":"6 нояб. · 18:29","text":"платная парковка вместо парковочной политики: липецку обещают 3,5 тысячи мест в липецке планируют создать более 3 500 платных парковочных мест на 35 участках улично-дорожной сети. стоимость стоянки составит 44 рубля в час. при этом введение платы само по себе не решает главную проблему города — хронический дефицит парковочного… транспорт липецк регион транспорт"},{"id":"15936","title":"Липецкая область на циркулярной карте России: рейтинг подтвердил, постановление закрепило","category":"Экология","date":"6 нояб. · 17:19","text":"липецкая область на циркулярной карте россии: рейтинг подтвердил, постановление закрепило платформа инфрагрин выпустила доклад «регионы и города россии 2026: циркулярность, экосистемы, адаптация» с обновленным рейтингом циркулярной трансформации эзц+. для липецкой области в нем — сразу две хорошие новости. в рамках федерального проекта… экология россия и мир экономика аналитика регион экология"},{"id":"15935","title":"Каждый год из-за непонятного почерка на выписанных рецептах погибает почти 7000 людей.","category":"Происшествия","date":"6 нояб. · 15:16","text":"каждый год из-за непонятного почерка на выписанных рецептах погибает почти 7000 людей. а более половины россиян самостоятельно ставят себе диагноз и занимаются самолечением. по данным минздрава, рф 88% жителей страны откладывают визит к врачу, предпочитая самолечение. при этом сами врачи подтверждают, что две трети пациентов больше доверяют… происшествия здоровье происшествия"},{"id":"15933","title":"Учитель физики — депутатам липецкого горсовета и облсовета: Не знаешь закон Ома — сиди дома.","category":"Политика","date":"6 нояб. · 13:26","text":"учитель физики — депутатам липецкого горсовета и облсовета: не знаешь закон ома — сиди дома. о несостоятельности довода о «корректировке базового уровня операционных расходов» в связи с приростом сетей и принятием бесхозяйных объектов 1️⃣ заместитель председателя комитета по жкх, дорожному строительству и транспорту липецкого областного совета… политика суд и право образование аналитика липецк регион политика"},{"id":"15932","title":"В Липецке автомобиль провалился в раскопанную яму на улице Титова возле заправки","category":"ЖКХ","date":"6 нояб. · 10:31","text":"в липецке автомобиль провалился в раскопанную яму на улице титова возле заправки по словам очевидцев, в момент происшествия опасный участок дороги не был огорожен. на кадрах, снятых позже, уже видны установленные дорожные барьеры. а днём ранее на улице литаврина беременная девушка упала в коммунальную раскопку с кипятком и получила… жкх транспорт липецк жкх"},{"id":"15930","title":"Особое мнение","category":"Транспорт","date":"5 нояб. · 21:49","text":"особое мнение трамвайная концессия в липецке: меньше путей за те же деньги по информации депутата облсовета (предположительно власти, вероятно, скрывают от граждан), правительство липецкой области и концессионер ооо «мовиста регионы липецк» заключили дополнительное… транспорт экономика политика липецк регион транспорт"},{"id":"15928","title":"Цифра дня: 28,8%. У вас растут такими темпами зарплаты и пенсии?","category":"Экономика","date":"5 нояб. · 21:22","text":"цифра дня: 28,8%. у вас растут такими темпами зарплаты и пенсии? рост тарифа для «рвк» на водоотведение с 1 июля 2027 года увеличится на 45,9%. в целом же предельный рост тарифов за услуги жкх для жителей липецка со второй половины следующего года составит 28,8%. вместо прогнозируемых 11%. согласно макропрогнозу… экономика жкх аналитика липецк регион экономика"},{"id":"15927","title":"Умер итальянский режиссер Тинто Брасс. Самый его известный фильм - \"Калигула\" (1979). В официальном советском кинопрокате его никогда не показывали.","category":"Культура","date":"4 нояб. · 21:40","text":"умер итальянский режиссер тинто брасс. самый его известный фильм - \"калигула\" (1979). в официальном советском кинопрокате его никогда не показывали. его картины почти всегда становились вызовом и цензуре, и публике. другие известные фильмы режиссера: ключ (la chiave, 1983) — классическая эротическая драма с стефанией сандрелли. миранда (miranda, 1985) — история о свободолюбивой владелице трактира.… культура культура"},{"id":"15926","title":"На стадионе \"Галатасарая\" зазвучала \"Калинка\" после голов российского полузащитника Алексея Батракова в матче Лиги чемпионов против немецкого…","category":"Спорт","date":"3 нояб. · 23:38","text":"на стадионе \"галатасарая\" зазвучала \"калинка\" после голов российского полузащитника алексея батракова в матче лиги чемпионов против немецкого…  спорт россия и мир спорт"},{"id":"15925","title":"Особое мнение","category":"Спорт","date":"3 нояб. · 18:10","text":"особое мнение спортивное счастье по-правительственному. липецкая область опять за бортом, а кампус под неопределённостью в правительстве россии составили список регионов, жители которых наиболее удовлетворены условиями для занятий физкультурой и спортом. липецкой… спорт власть экономика аналитика липецк регион спорт"},{"id":"15924","title":"Более трети россиян плакали на работе из-за замечаний: «Половина (47%) сотрудников хотя бы раз задумывались об увольнении после полученной…","category":"Россия и мир","date":"3 нояб. · 13:57","text":"более трети россиян плакали на работе из-за замечаний: «половина (47%) сотрудников хотя бы раз задумывались об увольнении после полученной… критика звучит регулярно. каждый четвёртый получает замечания не реже раза в неделю, ещё 24% — несколько раз в месяц. больше всего задевает несправедливая критика (57%), публичная (48%), в грубой форме (44%) и на повышенных тонах (39%). сложнее всего… россия и мир аналитика россия и мир"},{"id":"15923","title":"В Хлевенском округе — бешенство","category":"Общество","date":"3 нояб. · 13:19","text":"в хлевенском округе — бешенство на территории хлевенского муниципального округа липецкой области введены ограничительные мероприятия (карантин) по бешенству животных эпизоотическим очагом признано личное подворье в селе донская негачевка (ул. лесная, д. 6). неблагополучным пунктом… общество регион общество"},{"id":"15922","title":"Семёнов: «В каске ездил». Факт.","category":"Суд и право","date":"3 нояб. · 12:18","text":"семёнов: «в каске ездил». факт. советник первого замгубернатора липецкой области павел семёнов попытался сразу же оправдаться. получилось красноречивее любой критики. «в каске ездил» — признаёт. правда, студентом и тридцать лет назад. видимо, историческая давность здесь работает как… суд и право культура власть регион суд и право"},{"id":"15921","title":"Хищение на сумму более 160 млн рублей: прокуратура Липецкой области направила в суд уголовное дело о мошенничестве в сфере недвижимости","category":"Суд и право","date":"3 нояб. · 10:53","text":"хищение на сумму более 160 млн рублей: прокуратура липецкой области направила в суд уголовное дело о мошенничестве в сфере недвижимости прокуратурой липецкой области утверждено обвинительное заключение по уголовному делу о мошенничестве в сфере строительства и подделке документов (ч.4 ст.159 и ч.1 ст.327 ук рф). по версии следствия, 56‑летний местный житель предлагал гражданам услуги по… суд и право экономика липецк регион суд и право"},{"id":"15920","title":"«Сегодня в лице меня судят каждого русского, православного человека»","category":"Суд и право","date":"3 нояб. · 04:15","text":"«сегодня в лице меня судят каждого русского, православного человека» русский православный мужчина просит поддержки от неравнодушных людей. у даниила бусловского из липецка уже сегодня состоится суд. недавно лк рассказывал, о том, что в липецке возбудили уголовное дело против активиста даниила бусловского — волонтёра, бойца… суд и право липецк регион суд и право"},{"id":"15917","title":"ЖКХ по-липецки. Спрут: как увеличить размер платы за помещение","category":"ЖКХ","date":"2 нояб. · 20:09","text":"жкх по-липецки. спрут: как увеличить размер платы за помещение отопительный сезон начался, аварии продолжаются: рир „энерго“ не готово 1️⃣ на оперативном совещании в администрации липецка выяснилось, что отопительный сезон начался с незавершённых аварийных работ на теплосетях. рир «энерго» не уложилось даже в… жкх происшествия суд и право липецк регион жкх"},{"id":"15916","title":"В центральный аппарат ведомства представят доклад по обращению жителей Липецкой области о нарушении их прав","category":"Власть","date":"2 нояб. · 16:43","text":"в центральный аппарат ведомства представят доклад по обращению жителей липецкой области о нарушении их прав в социальных медиа размещено обращение жителей города лебедяни липецкой области к председателю ск россии. граждане сообщают о нарушении их прав в связи с предстоящим закрытием клуба в покрово-казацкой слободе и передачей его в пользование частных лиц. по… власть лебедянь регион власть"},{"id":"15914","title":"Услуги ЖКХ в России могут взлететь в цене из-за дополнительных надбавок, соответствующую инициативу предложил Минстрой. Сборы на ремонт изношенных…","category":"ЖКХ","date":"2 нояб. · 15:00","text":"услуги жкх в россии могут взлететь в цене из-за дополнительных надбавок, соответствующую инициативу предложил минстрой. сборы на ремонт изношенных… минстрой предлагает расширить возможности повышения платежей за жкх, причём часть решений перенести с федерального на региональный уровень. это создаёт предпосылки для более существенного роста коммунальных платежей, в том числе сверх привычных для… жкх экономика россия и мир регион жкх"},{"id":"15913","title":"Ипотека для избранных: что на самом деле показывает рейтинг РИА","category":"Экономика","date":"2 нояб. · 14:29","text":"ипотека для избранных: что на самом деле показывает рейтинг риа «липецкая область стала лидером по доступности ипотеки в черноземье» — такие заголовки можно встретить сегодня. региональные издания поспешили представить очередной рейтинг риа новости как свидетельство благополучия. при этом никто, похоже, не попытался… экономика жкх аналитика липецк регион экономика"},{"id":"15912","title":"Врачи советуют спать прямо на работе 20-30 минут","category":"Здоровье","date":"2 нояб. · 12:33","text":"врачи советуют спать прямо на работе 20-30 минут днём организм естественно теряет бодрость, а короткий сон помогает восстановиться и работать продуктивнее. главное — не спать дольше 40 минут, иначе можно проснуться ещё более разбитым. проверяем! здоровье здоровье"},{"id":"15911","title":"\"Площадь\" о том, что возрождающийся тракторный завод в Липецке задолжал своей охране почти 7 млн рублей","category":"Экономика","date":"2 нояб. · 12:31","text":"\"площадь\" о том, что возрождающийся тракторный завод в липецке задолжал своей охране почти 7 млн рублей ооо «частная охранная организация «альфа» из чебоксар подала иск к юрлицу возрождающегося «липецкого тракторного завода» на более чем 6,8 млн рублей. согласно исковому заявлению, большая часть суммы – это долг предприятия по договору на оказание услуг по… экономика суд и право липецк экономика"},{"id":"15910","title":"Липецкий кузнечный завод получил шанс избежать банкротства","category":"Экономика","date":"2 нояб. · 12:28","text":"липецкий кузнечный завод получил шанс избежать банкротства арбитражный суд липецкой области ввел в отношении ооо «липецкий кузнечный завод» процедуру внешнего управления сроком на 18 месяцев. решение принято после того, как в ходе наблюдения были выявлены экономические предпосылки для восстановления… экономика суд и право аналитика регион экономика"},{"id":"15906","title":"О чём молчат фанфары Соборной","category":"Спорт","date":"1 нояб. · 18:05","text":"о чём молчат фанфары соборной «задача выполнена»: 113 миллионов, 95 процентов гастролёров на поле и пятое место как потолок 1️⃣ в старом осколе состоялся заключительный матч сезона второй лиги по футболу дивизиона б, в котором белгородский «салют» уверенно одержал победу над командой… спорт сельское хозяйство власть аналитика липецк регион спорт"},{"id":"15901","title":"1 ноября","category":"Россия и мир","date":"1 нояб. · 11:13","text":"1 ноября 1068 первая победа русских над половцами. черниговский князь святослав (на миниатюре – с семьей) с 3-тыс. дружиной разбил их 12-тыс. войско на р.снове. хан шарукан попал в плен. святослав – дружине: «пойдемте в битву! нам некуда больше деться» 1612… россия и мир россия и мир"},{"id":"15898","title":"Электричество дороже, тарифная нагрузка выше: Липецкая область стала лидером ЦФО по цене киловатта","category":"Экономика","date":"31 окт. · 12:29","text":"электричество дороже, тарифная нагрузка выше: липецкая область стала лидером цфо по цене киловатта липецкая область стала самым дорогим регионом центрального федерального округа по стоимости электроэнергии для населения. во ii полугодии 2026 года киловатт-час для жителей обычных городских квартир без электроплит, потребляющих электричество во втором… экономика жкх россия и мир аналитика липецк регион экономика"},{"id":"15897","title":"В Липецке расследовали дело о посредничестве во взятке за условно-досрочное освобождение","category":"Суд и право","date":"31 окт. · 11:37","text":"в липецке расследовали дело о посредничестве во взятке за условно-досрочное освобождение в липецке завершено расследование уголовного дела в отношении 43-летнего местного жителя, обвиняемого в посредничестве во взяточничестве в крупном размере (ч. 2 ст. 291.1 ук рф). по версии следствия, в 2022 году, отбывая наказание в исправительной колонии… суд и право россия и мир липецк регион суд и право"},{"id":"15896","title":"Сегодня отмечается День тренера.","category":"Общество","date":"30 окт. · 17:40","text":"сегодня отмечается день тренера. поздравляем всех причастных. сил, вдохновения, талантливых воспитанников и побед. общество общество"},{"id":"15895","title":"Губернатор Игорь Артамонов о проекте университетского кампуса в Липецке","category":"Образование","date":"30 окт. · 15:36","text":"губернатор игорь артамонов о проекте университетского кампуса в липецке кампус создадут в липецке на площадке недостроенного спорткомплекса «катящихся камней». здесь разместятся спортивный комплекс с бассейном, деловой центр для проведения форумов и конференций, современный лабораторный корпус, технопарк для… образование власть экономика липецк регион образование"},{"id":"15894","title":"Самое дорогое – это абсурд депутатов, за который людям и бюджету приходится платить","category":"Политика","date":"30 окт. · 13:05","text":"самое дорогое – это абсурд депутатов, за который людям и бюджету приходится платить когда за чужие убытки платят люди: в снт разбирается следствие, за рвк вступились депутаты вчера лк рассказал историю из нашей серии \"конгениально!\". предполагаем, что многие её недооценивают и не увидели аналогий. липецкая прокуратура сообщила о… политика экономика суд и право липецк регион политика"},{"id":"15893","title":"Липецкий проект университетского кампуса прошел федеральный отбор","category":"Образование","date":"30 окт. · 11:54","text":"липецкий проект университетского кампуса прошел федеральный отбор проект современного университетского кампуса в липецке вошел в число победителей четвертого отбора минобрнауки россии. всего в федеральный проект «создание сети современных кампусов» включены 19 проектов в 17 городах. об этом 30 октября сообщило… образование россия и мир экономика липецк регион образование"},{"id":"15892","title":"Росприроднадзор предъявил липецкому «Куриному царству» иск почти на 123 млн рублей","category":"Суд и право","date":"30 окт. · 11:29","text":"росприроднадзор предъявил липецкому «куриному царству» иск почти на 123 млн рублей северо-уральское межрегиональное управление росприроднадзора обратилось в арбитражный суд липецкой области с иском к ао «куриное царство» — липецкому предприятию, входящему в группу «черкизово» семьи михайловых. сумма претензий составляет 122,9 млн рублей.… суд и право экономика сельское хозяйство аналитика липецк елец задонск суд и право"},{"id":"15891","title":"Миллион мальков на четыре пресс-релиза: зачем бюджету столько информационных рыбаков","category":"Экономика","date":"29 окт. · 22:18","text":"миллион мальков на четыре пресс-релиза: зачем бюджету столько информационных рыбаков хронология зарыбления реки воронеж выглядит как наглядный пример тиражирования одной новости: 14 августа — gorod48 сообщил: «нлмк выпустит в реку воронеж более пяти тонн мальков сазана». 14 августа — \"нлмк выпустит в реку воронеж более пяти тонн мальков… экономика власть регион экономика"},{"id":"15890","title":"GOROD48 — 20 лет без шампанского и Уэста","category":"Суд и право","date":"29 окт. · 20:14","text":"gorod48 — 20 лет без шампанского и уэста 29 октября gorod48 отмечает 20-летие. по сообщению издания именно этот день. точнее мог бы отметить. однако судя по всему, «день взятия бастилии впустую прошел»: без подарков, шампанского, танцев и корпоративного веселья. в конце августа лк сообщал в… суд и право липецк суд и право"},{"id":"15889","title":"Домашние животные в Липецкой области нападают чаще бездомных","category":"Общество","date":"29 окт. · 17:18","text":"домашние животные в липецкой области нападают чаще бездомных 1 585 бездомных животных отловили в липецкой области с начала года. 354 из них нашли новых хозяев, 1 182 вернули на улицы, 30 погибли, 23 усыпили из-за агрессии. всего в липецкой области более 3 800 бездомных животных. за год зарегистрировано 913 случаев… общество регион общество"},{"id":"15888","title":"В Липецкой области раскрыли схему обналичивания через 70 фиктивных компаний","category":"Суд и право","date":"29 окт. · 17:08","text":"в липецкой области раскрыли схему обналичивания через 70 фиктивных компаний пятерых жителей региона обвиняют в незаконной банковской деятельности. по версии следствия, за четыре года они заработали на обналичивании более 33 млн рублей, взимая с клиентов комиссию не менее 12%. прокуратура липецкой области утвердила обвинительное… суд и право экономика липецк регион суд и право"},{"id":"15887","title":"Недавно «Липецкий котёл» сообщил, что в Ельце после ракетной атаки погиб сотрудник охраны промышленного предприятия, ещё несколько человек…","category":"Происшествия","date":"29 окт. · 16:42","text":"недавно «липецкий котёл» сообщил, что в ельце после ракетной атаки погиб сотрудник охраны промышленного предприятия, ещё несколько человек… сирена должна означать безусловный переход работников в безопасное место без потери заработка. всё остальное — это риск имитации безопасности ценой человеческих жизней. в социальной сети «вконтакте» (группа «потребитель 48 липецк») проводится опрос: «при… происшествия экономика липецк елец регион происшествия"},{"id":"15886","title":"Из коллекции «Конгениально!»","category":"Суд и право","date":"29 окт. · 16:26","text":"из коллекции «конгениально!» члены садоводческого товарищества своими силами выполнили ремонтные работы, а директор снт присвоил полученные деньги на эти цели по инициативе прокуратуры липецкого района возбуждено дело о мошенничестве при получении региональной субсидии прокуратура… суд и право экономика регион суд и право"},{"id":"15885","title":"Туалеты на 10 млн рублей: директору «Культурных пространств Липецка» грозит дело о мошенничестве","category":"Суд и право","date":"29 окт. · 16:06","text":"туалеты на 10 млн рублей: директору «культурных пространств липецка» грозит дело о мошенничестве прокуратура выявила признаки искусственного дробления закупок, ограничения конкуренции и использования подложных коммерческих предложений. четыре контракта на 27,6 млн рублей обернулись уголовным делом о предполагаемом хищении почти 10 млн рублей. в… суд и право экономика культура липецк регион суд и право"},{"id":"15882","title":"Секвестр госпрограммы ЖКХ и городской среды Липецкой области","category":"ЖКХ","date":"29 окт. · 15:51","text":"секвестр госпрограммы жкх и городской среды липецкой области 1️⃣ постановлением правительства липецкой области от 19.10.2026 № и03/23п-дсп региональная госпрограмма «обеспечение населения качественными коммунальными услугами и формирование современной городской среды» скорректирована уже в 11-й раз за неполные три… жкх экономика власть аналитика регион жкх"},{"id":"15881","title":"Липецкий завод тепличных конструкций избежал банкротства после погашения долга в 92 млн рублей","category":"Экономика","date":"29 окт. · 11:58","text":"липецкий завод тепличных конструкций избежал банкротства после погашения долга в 92 млн рублей арбитражный суд липецкой области прекратил производство по делу о банкротстве ооо «липецкий завод тепличных конструкций» после того, как предприятие рассчиталось с задолженностью перед бюджетом. с заявлением о признании компании банкротом в суд обратилась… экономика суд и право регион экономика"},{"id":"15879","title":"В центральный аппарат ведомства представят доклад по обращению жителей Липецкой области о нарушении их жилищных прав","category":"ЖКХ","date":"29 окт. · 10:19","text":"в центральный аппарат ведомства представят доклад по обращению жителей липецкой области о нарушении их жилищных прав в социальных медиа размещено коллективное обращение жильцов дома по улице циолковского города липецка к председателю ск россии. граждане сообщают о длительных проблемах с отоплением в их доме, что создает тяжелые условия для проживания, в том числе в… жкх власть россия и мир липецк регион жкх"}],"staticMode":true}],"$Lc"]}],"$Ld"]}],"$Le","$Lf","$L10"]}]
